[Unit]
Description=Live Dictation Tray Daemon (local whisper)
After=graphical-session.target pipewire.service
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=/home/atlas/projects/Scriberr/linux
ExecStart=/home/atlas/projects/Scriberr/linux/.venv/bin/python live_dictate.py
Restart=on-failure
RestartSec=3s
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
